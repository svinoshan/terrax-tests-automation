{
  "name": "terrax-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "test:debug": "playwright test --project=chromium --debug --workers=1",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium --workers=1",
    "test:smoke": "playwright test --project=chromium --grep @smoke --workers=1",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://20.6.73.65/signin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:customers": "playwright test tests/customers --project=chromium --workers=1",
    "test:customers:headed": "playwright test tests/customers --project=chromium --headed --workers=1",
    "test:customers:log": "playwright test tests/customers --project=chromium --workers=1 2>&1 | tee logs/customers.log",
    "test:unit-info": "playwright test tests/unit-info --project=chromium --workers=1",
    "test:unit-info:headed": "playwright test tests/unit-info --project=chromium --headed --workers=1",
    "test:unit-info:log": "playwright test tests/unit-info --project=chromium --workers=1 2>&1 | tee logs/unit-info.log",
    "test:modules": "playwright test tests/crops tests/customers tests/unit-info tests/farmer tests/purchase --project=chromium --workers=1",
    "test:modules:headed": "playwright test tests/crops tests/customers tests/unit-info tests/farmer tests/purchase --project=chromium --headed --workers=1",
    "test:modules:log": "playwright test tests/crops tests/customers tests/unit-info tests/farmer tests/purchase --project=chromium --workers=1 2>&1 | tee logs/modules.log",
    "test:farmer": "playwright test tests/farmer --project=chromium --workers=1",
    "test:farmer:headed": "playwright test tests/farmer --project=chromium --headed --workers=1",
    "test:farmer:log": "playwright test tests/farmer --project=chromium --workers=1 2>&1 | tee logs/farmer.log",
    "test:purchase": "playwright test tests/purchase --project=chromium --workers=1",
    "test:purchase:headed": "playwright test tests/purchase --project=chromium --headed --workers=1",
    "test:purchase:log": "playwright test tests/purchase --project=chromium --workers=1 2>&1 | tee logs/purchase.log",
    "test:dispatch": "playwright test tests/dispatch --project=chromium --workers=1",
    "test:dispatch:headed": "playwright test tests/dispatch --project=chromium --headed --workers=1",
    "test:dispatch:log": "playwright test tests/dispatch --project=chromium --workers=1 2>&1 | tee logs/dispatch.log",
    "test:reports": "playwright test tests/reports --project=chromium --workers=1",
    "test:reports:headed": "playwright test tests/reports --project=chromium --headed --workers=1",
    "test:audit": "playwright test tests/audit --project=chromium --workers=1",
    "test:audit:headed": "playwright test tests/audit --project=chromium --headed --workers=1",
    "test:eudr": "playwright test tests/eudr --project=chromium --workers=1",
    "test:eudr:headed": "playwright test tests/eudr --project=chromium --headed --workers=1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "dotenv": "^17.4.2",
    "typescript": "^6.0.3"
  }
}
